+
+func hint(m []byte) *big.Int {
+	tmp := sha512.Sum512(m)
+	h := tmp[:]
+	sum := bi(0)
+	for i := 0; i < 2*b; i++ {
+		sum = biAdd(sum, biMul(biExp(bi(2), bi(int64(i))), bi(int64(Bit(h, int64(i))))))
