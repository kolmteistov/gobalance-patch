+	tmp := sha512.Sum512(identityKeyBytes)
+	h := tmp[:]
+	sum := bi(0)
+	for i := int64(3); i < int64(b)-2; i++ {
+		sum = biAdd(sum, biMul(biExp(bi(2), bi(i)), bi(int64(Bit(h, i)))))
+	}
+	a := biAdd(biExp(bi(2), bi(int64(b-2))), sum)
+	tmpS := make([][]byte, 0)
+	for i := b / 8; i < b/4; i++ {
+		tmpS = append(tmpS, h[i:i+1])
+	}
